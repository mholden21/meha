import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from scipy import stats, optimize, integrate


df = pd.read_csv("hubble_data.csv")


(df.head())


print(df.shape)


print(df.columns)


print(df.info())


print(df.describe())


#hubbles law shows relationship between velocity and distance


plt.figure()
x = df["distance_Mpc"]
y= df["velocity_kms"]
plt.scatter(df["distance_Mpc"],df["velocity_kms"], label = "galaxy data")
plt.title("distance vs velocity")
plt.xlabel("distance (mpc)")
plt.ylabel("velocity (km/s)")
plt.legend()


def hubble_law(distance, H0, intercept):
    return H0*distance + intercept


H0 = 70
popt, pcov = optimize.curve_fit(hubble_law, x, y)
H0_fit, intercept_fit = popt
H0_uncert, intercept_uncert = np.sqrt(np.diag(pcov))

print(f"Best Fit H0: H0_fit +/- {H0_uncert} km/s/MPc")
print(f"Best Fit intercept: intercept fit +/- {intercept_uncert} km/s/MPc")


plt.figure()
x = df["distance_Mpc"]
y= df["velocity_kms"]
plt.scatter(df["distance_Mpc"],df["velocity_kms"], label = "galaxy data")
plt.plot(x, hubble_law(x, H0_fit, intercept_fit), label = "best fit")
plt.title("distance vs velocity")
plt.xlabel("distance (mpc)")
plt.ylabel("velocity (km/s)")
plt.legend()


